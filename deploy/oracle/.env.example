# Create a strong secret using: openssl rand -hex 32
APP_SECRET_KEY=replace-with-a-random-64-character-secret
GROQ_API_KEY=replace-with-your-groq-api-key

# Point a free DNS hostname (for example, a DuckDNS subdomain) to your VM public IPv4.
PUBLIC_HOSTNAME=your-subdomain.duckdns.org
ACME_EMAIL=you@example.com
