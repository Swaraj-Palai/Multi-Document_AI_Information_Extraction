# LLM / Groq API Configuration
GROQ_API_KEY=your_groq_api_key_here
LLM_API_KEY=your_groq_api_key_here
LLM_MODEL=openai/gpt-oss-120b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1000

# Embeddings Configuration
EMBEDDING_PROVIDER=bge-m3
EMBEDDING_MODEL=BAAI/bge-m3
# Alternative: sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# BGE-M3 Settings (CPU-only)
BGE_M3_MODEL_PATH=./models/bge-m3
BGE_M3_DEVICE=cpu
BGE_M3_BATCH_SIZE=1
BGE_M3_MAX_LENGTH=1024

# Vector Store
VECTOR_DB_PATH=vector_db/db_faiss
UPLOAD_FOLDER=uploads

# Query Rewriting
ENABLE_QUERY_REWRITING=true

# Chunking & Retrieval
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
TOP_K=4

# OCR Configuration
OCR_ENABLED=true
OCR_THREADS=4
OCR_DPI=250
OCR_MODE=auto
OCR_TEXT_THRESHOLD=50

# Server
PORT=5000
HOST=0.0.0.0
